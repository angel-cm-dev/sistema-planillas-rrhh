# Copie este archivo como .env y reemplace los valores. NUNCA suba su .env al repositorio.

# Contraseña del usuario "sa" de SQL Server (mín. 8 caracteres con mayúscula, minúscula, número y símbolo)
MSSQL_SA_PASSWORD=Cambiar_Esta_Clave_123

# Clave para firmar los JWT (mínimo 32 caracteres, aleatoria). Ej.: openssl rand -base64 48
JWT_KEY=reemplazar-por-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRA_MINUTOS=480

# Puertos publicados en el host
DB_PORT=1433
API_PORT=5080
WEB_PORT=8080
