# URL base del API. Vacío = rutas relativas (/api), que en desarrollo resuelve el proxy de Vite
# y en Docker el proxy de nginx. Úselo solo si sirve el frontend desde otro dominio.
VITE_API_URL=

# Destino del proxy de Vite en desarrollo (por defecto http://localhost:5080)
VITE_PROXY_TARGET=http://localhost:5080
